{
    "name": "cydrobolt/polr",
    "description": "The Polr URL Shortener.",
    "keywords": ["url-shortener", "url", "cms"],
    "license": "GPLv2+",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "laravel/lumen-framework": "^11.0",
        "vlucas/phpdotenv": "^5.4.1",
        "illuminate/mail": "^11.0",
        "illuminate/session": "^11.0",
        "illuminate/cookie": "^11.0",
        "yajra/laravel-datatables-oracle": "^11.0",
        "torann/geoip": "^3.0",
        "geoip2/geoip2": "^2.4|^3.0",
        "nesbot/carbon": "^2.62|^3.0",
        "doctrine/dbal": "^3.0|^4.0",
        "google/recaptcha": "^1.2",
        "symfony/http-foundation": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "symfony/css-selector": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/"
        ],
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
